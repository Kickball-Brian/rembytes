# Copy to .env for local dev. In Netlify, set these under Site configuration → Environment variables.

# ── Cloudflare Turnstile (spam protection) ─────────────────────────
# Public site key, exposed to the browser at build time.
VITE_TURNSTILE_SITE_KEY=
# Secret key, server only. Never prefix with VITE_.
TURNSTILE_SECRET=

# ── Resend (email delivery) ────────────────────────────────────────
RESEND_API_KEY=
# Must be on a domain you've verified in Resend.
CONTACT_FROM="rembytes.com <contact@rembytes.com>"
# Where new messages are delivered.
CONTACT_TO=brian@rembytes.com

# ── Optional ───────────────────────────────────────────────────────
# Random string used when hashing visitor IPs for rate limiting.
IP_HASH_SALT=
