# Copy to .env for local dev, or to /etc/rembytes.env on a server (systemd EnvironmentFile).
# On Netlify (staging) set the same names under Site configuration → Environment variables.

# ── Cloudflare Turnstile (spam protection) ─────────────────────────
# Public site key, baked into the page at BUILD time (rebuild after changing it).
VITE_TURNSTILE_SITE_KEY=
# Secret key, server only. Never prefix with VITE_. Missing = every submission refused.
TURNSTILE_SECRET=

# ── Resend (email delivery, an HTTPS API that works from any host) ─
RESEND_API_KEY=
# Must be on a domain verified in Resend.
CONTACT_FROM="rembytes.com <contact@rembytes.com>"
# Where new messages are delivered.
CONTACT_TO=brian@rembytes.com

# ── Optional ───────────────────────────────────────────────────────
# Random string mixed into the IP hash used for rate limiting.
IP_HASH_SALT=

# ── Standalone Node server only (server/index.mjs) ─────────────────
PORT=8787
HOST=127.0.0.1
# Where messages are saved, as one JSON file each. Back this folder up.
DATA_DIR=./data
# Serve the built site too (only if you have no nginx/Apache in front): STATIC_DIR=./dist
STATIC_DIR=
# true ONLY behind your own reverse proxy that sets X-Real-IP and X-Forwarded-Host.
TRUST_PROXY=false
# true on staging to send X-Robots-Tag: noindex.
NOINDEX=false
