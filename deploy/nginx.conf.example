# nginx: serves the static build and proxies /api/ to the Node server.
# Put the limit_req_zone line in the http {} block (e.g. /etc/nginx/conf.d/rembytes-limits.conf):
#   limit_req_zone $binary_remote_addr zone=rembytes_api:10m rate=10r/m;

server {
    listen 80;
    server_name rembytes.com www.rembytes.com;
    return 301 https://rembytes.com$request_uri;
}

server {
    listen 443 ssl http2;
    server_name rembytes.com;

    # ssl_certificate     /etc/letsencrypt/live/rembytes.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/rembytes.com/privkey.pem;

    root  /var/www/rembytes/dist;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # NOTE: add_header in a location block REPLACES inherited ones, so the shared set is included each time.
    include /etc/nginx/snippets/rembytes-headers.conf;

    # Hashed build output never changes: cache for a year.
    location /assets/ {
        include /etc/nginx/snippets/rembytes-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Contact API → Node process (server/index.mjs, TRUST_PROXY=true).
    location /api/ {
        limit_req zone=rembytes_api burst=5 nodelay;
        client_max_body_size 32k;

        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;   # overwrite, never append client-supplied values
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 20s;
    }

    # /contact/ → dist/contact/index.html
    location / {
        try_files $uri $uri/ =404;
    }
}
