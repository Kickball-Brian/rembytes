# systemd unit for the contact API.  Install:
#   sudo cp deploy/rembytes-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now rembytes-api
#
# Assumes: code in /var/www/rembytes, config in /etc/rembytes.env (chmod 640, root:rembytes),
#          messages stored in /var/lib/rembytes, Node 20+ at /usr/bin/node.
[Unit]
Description=rembytes.com contact API
After=network.target

[Service]
Type=simple
User=rembytes
Group=rembytes
WorkingDirectory=/var/www/rembytes
EnvironmentFile=/etc/rembytes.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node server/index.mjs
Restart=on-failure
RestartSec=3

# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rembytes
StateDirectory=rembytes

[Install]
WantedBy=multi-user.target
